# Exclusively used by the isolated Railway homologacao service.
# Explicit ECR base avoids anonymous Docker Hub rate limits.
FROM public.ecr.aws/docker/library/node:22-alpine

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY . .

EXPOSE 8080
CMD ["node", "src/homolog.js"]
