# ---- Discord ----
DISCORD_TOKEN=cole_o_token_do_bot_aqui
CTA_CHANNEL_ID=id_do_canal_cta-mandatorio
IMORTAL_ROLE_ID=id_do_cargo_Imortal
STAFF_LOG_CHANNEL_ID=id_do_canal_cta-log-staff   # feed ao vivo de inscricoes

# Horarios pre-setados (UTC / horario do jogo), separados por virgula
PRESET_TIMES=17:20,19:20,21:20

# ---- Banco (Railway injeta DATABASE_URL automaticamente) ----
DATABASE_URL=postgres://user:pass@host:5432/db
# PGSSL=disable   # so se o Postgres for local sem SSL

# ---- Albion GameInfo / Kill Fame (todos opcionais) ----
# API pública usada somente pelo enriquecimento em segundo plano.
# ALBION_GAMEINFO_BASE=https://gameinfo.albiononline.com/api/gameinfo
# Janela máxima para casar DiedEvent com o kill oficial (ms). Padrão: 120000.
# ALBION_FAME_MATCH_WINDOW_MS=120000
# Timeout por request da API pública (ms). Padrão: 8000.
# ALBION_API_TIMEOUT_MS=8000
# Máximo de requests simultâneos ao GameInfo. Padrão: 2.
# ALBION_API_CONCURRENCY=2
# Ritmo global máximo de início de requests por segundo. Padrão: 2.
# ALBION_API_RATE_PER_SECOND=2
# Janela semântica para fundir o mesmo kill visto por múltiplos observers (ms). Padrão: 15000.
# ALBION_FAME_DEDUP_WINDOW_MS=15000
# Janela mínima para coalescer invalidação/notificação do cache por CTA (ms). Padrão: 15000.
# ALBION_FAME_RESOLVED_COALESCE_MS=15000

# ---- Guild Might / Guild Challenge: publicação segura de rankings ----
# Data/Hora UTC ISO-8601 do início da temporada ATUAL, confirmada pela staff.
# Exemplo de formato APENAS: 2026-10-01T00:00:00Z (não use sem conferir).
# Sem data e sem transição real entre IDs Photon de temporada verificada,
# a aba Might mostra aviso de configuração e NÃO publica ranking provisório.
# GUILD_SEASON_START_AT=
# IDs EXATOS dos dispositivos autorizados pela staff a alimentar rankings,
# separados por vírgula (IDs de dispositivos, não nomes de jogadores/roles).
# Sem lista, nenhum dispositivo alimenta rankings de produção e a aba
# mostra aviso explícito. Token de pareamento sozinho NÃO autoriza ranking.
# GUILD_RANKING_ALLOWED_DEVICE_IDS=
# Somente homologação: HOMOLOG_MODE=1 habilita WORKSPACEIGOR por padrão.
# Nunca definir HOMOLOG_MODE=1 na produção.
