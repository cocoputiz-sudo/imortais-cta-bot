# ---- Discord ----
DISCORD_TOKEN=cole_o_token_do_bot_aqui
CTA_CHANNEL_ID=id_do_canal_cta-mandatorio
IMORTAL_ROLE_ID=id_do_cargo_Imortal
STAFF_LOG_CHANNEL_ID=id_do_canal_cta-log-staff   # feed ao vivo de inscricoes

# Horarios pre-setados (UTC / horario do jogo), separados por virgula
PRESET_TIMES=17:20,19:20,21:20

# ---- Banco (Railway injeta DATABASE_URL automaticamente) ----
DATABASE_URL=postgres://user:pass@host:5432/db
# PGSSL=disable   # so se o Postgres for local sem SSL

# ---- Guild Might / Guild Challenge: autorização dinâmica e temporada ----
# Início UTC CONFIRMADO da temporada atual. Configurar na produção SOMENTE
# após aprovação explícita do deploy de variáveis.
# GUILD_SEASON_START_AT=2026-09-12T00:00:00Z
#
# PADRÃO: TODOS os dispositivos cadastrados em albion_telemetry_devices
# com PELO MENOS UM token em albion_telemetry_agent_tokens cujo
# revoked_at IS NULL. Sem lista fixa; dispositivo offline continua elegível.
# Ao revogar o ÚLTIMO token ativo, seus dados desaparecem do ranking
# recalculado. Não apaga os snapshots históricos.
#
# OPÇÃO DE RESTRIÇÃO adicional (interseção; nunca substitui o pareamento):
# GUILD_RANKING_ALLOWED_DEVICE_IDS=ID1,ID2
# Deixar ausente para incluir todos os dispositivos pareados não revogados.
# Tokens revogados NUNCA são reautorizados por essa variável.
#
# Confirmação da guilda IMORTAIS via bytes Photon continua obrigatória.
# Se não houver pareamentos válidos, a aba exibe aviso de configuração;
# dados não verificados não aparecem no ranking.
